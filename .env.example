# Local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie encryption
COOKIE_PASSWORD=
HEALTH_CHECK_SECRET=

# S3 image upload
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Legacy upload compatibility
AWS_REGIN=ap-northeast-2
AMPLIFY_BUCKET=

# AI report generation
# true 이면 실제 LLM 호출(Gemini 우선 → OpenAI), false/미설정이면 규칙 기반 fallback
AI_REPORTS_ENABLED=false
# Gemini (키 있으면 OpenAI보다 먼저 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 특정 이메일만 실제 AI 허용 (비우면 전체 허용)
AI_BETA_EMAILS=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
